@page "/admin/lessons"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<main class="page">
    <div class="page-heading">
        <div>
            <h1>Lectii</h1>
            <p>Continut educational scurt pentru pregatirea jucatorilor.</p>
        </div>
    </div>

    <EditForm Model="_lesson" OnValidSubmit="SaveLessonAsync" class="form-panel">
        <input @bind="_lesson.Title" placeholder="Titlu" />
        <input @bind="_lesson.Slug" placeholder="slug" />
        <textarea @bind="_lesson.Content" rows="6" placeholder="Continut"></textarea>
        <label class="check"><input type="checkbox" @bind="_lesson.IsPublished" /> Publicata</label>
        <button class="button primary" type="submit">Salveaza lectie</button>
    </EditForm>

    <section class="content-band">
        @foreach (var lesson in _lessons)
        {
            <article class="lesson-row">
                <h2>@lesson.Title</h2>
                <p>@lesson.Content</p>
                <button class="button small" @onclick="() => Edit(lesson)">Editeaza</button>
            </article>
        }
    </section>
</main>

@code {
    private List<Lesson> _lessons = [];
    private Lesson _lesson = new() { IsPublished = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lessons = await db.Lessons.AsNoTracking().OrderBy(x => x.DisplayOrder).ToListAsync();
    }

    private void Edit(Lesson lesson)
    {
        _lesson = new Lesson
        {
            Id = lesson.Id,
            Title = lesson.Title,
            Slug = lesson.Slug,
            Content = lesson.Content,
            IsPublished = lesson.IsPublished,
            DisplayOrder = lesson.DisplayOrder,
            CategoryId = lesson.CategoryId
        };
    }

    private async Task SaveLessonAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Lessons.FindAsync(_lesson.Id);
        if (existing is null)
        {
            db.Lessons.Add(_lesson);
        }
        else
        {
            existing.Title = _lesson.Title;
            existing.Slug = _lesson.Slug;
            existing.Content = _lesson.Content;
            existing.IsPublished = _lesson.IsPublished;
        }
        await db.SaveChangesAsync();
        _lesson = new Lesson { IsPublished = true };
        await LoadAsync();
    }
}
