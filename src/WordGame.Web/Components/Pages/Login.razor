@page "/login"
@inject IHttpContextAccessor HttpContextAccessor
@inject IAntiforgery Antiforgery
@inject NavigationManager Navigation

<main class="page narrow">
    <h1>Login host/admin</h1>
    @if (Navigation.Uri.Contains("error=1", StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert error">Email sau parola incorecta.</div>
    }
    <form class="form-panel" method="post" action="/auth/login">
        <input type="hidden" name="__RequestVerificationToken" value="@_token" />
        <label>Email</label>
        <input name="Email" type="email" autocomplete="username" required />
        <label>Parola</label>
        <input name="Password" type="password" autocomplete="current-password" required />
        <label class="check"><input name="RememberMe" type="checkbox" /> Tine-ma minte</label>
        <button class="button primary" type="submit">Autentificare</button>
    </form>
</main>

@code {
    private string? _token;

    protected override void OnInitialized()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context is not null)
        {
            _token = Antiforgery.GetAndStoreTokens(context).RequestToken;
        }
    }
}
