@page "/admin/games"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<main class="page">
    <div class="page-heading">
        <div>
            <h1>Istoric jocuri</h1>
            <p>Rezultatele finalizate sunt persistate in PostgreSQL.</p>
        </div>
    </div>

    <div class="table-wrap">
        <table>
            <thead><tr><th>Camera</th><th>Jucatori</th><th>Intrebari</th><th>Finalizat</th></tr></thead>
            <tbody>
            @foreach (var game in _games)
            {
                <tr>
                    <td class="code">@game.RoomCode</td>
                    <td>@game.PlayerCount</td>
                    <td>@game.QuestionCount</td>
                    <td>@game.FinishedAt.LocalDateTime.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</main>

@code {
    private List<GameSession> _games = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _games = await db.GameSessions.AsNoTracking()
            .OrderByDescending(x => x.FinishedAt)
            .Take(100)
            .ToListAsync();
    }
}
