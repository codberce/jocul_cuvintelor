@page "/admin/questions"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<main class="page">
    <div class="page-heading">
        <div>
            <h1>Administrare intrebari</h1>
            <p>CRUD, activare/dezactivare, import si export JSON/CSV.</p>
        </div>
        <div class="actions">
            <a class="button" href="/admin/questions/export.json">Export JSON</a>
            <a class="button" href="/admin/questions/export.csv">Export CSV</a>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="alert">@_message</div>
    }

    <section class="content-band">
        <h2>Adauga intrebare</h2>
        <EditForm Model="_newQuestion" OnValidSubmit="AddQuestionAsync" class="form-grid">
            <input @bind="_newQuestion.Answer" placeholder="Raspuns" />
            <input @bind="_newQuestion.Definition" placeholder="Definitie" />
            <select @bind="_newQuestion.CategoryId">
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <select @bind="_newQuestion.SubjectId">
                @foreach (var subject in _subjects)
                {
                    <option value="@subject.Id">@subject.Name</option>
                }
            </select>
            <select @bind="_newQuestion.Difficulty">
                @foreach (var value in Enum.GetValues<Difficulty>())
                {
                    <option value="@value">@value</option>
                }
            </select>
            <input type="number" min="5" max="120" @bind="_newQuestion.TimeLimitSeconds" />
            <button class="button primary" type="submit">Adauga</button>
        </EditForm>
    </section>

    <section class="content-band">
        <h2>Import JSON/CSV</h2>
        <textarea @bind="_importText" rows="6" placeholder="JSON exportat sau CSV cu Answer,Definition,Subject,Category,Difficulty,TimeLimitSeconds,IsActive"></textarea>
        <button class="button" @onclick="ImportAsync">Importa</button>
    </section>

    <section class="content-band">
        <div class="filters">
            <input @bind="_filter" @bind:event="oninput" placeholder="Filtreaza dupa text" />
            <button class="button" @onclick="LoadAsync">Reincarca</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Raspuns</th><th>Definitie</th><th>Materie</th><th>Categorie</th><th>Dificultate</th><th>Activ</th><th></th></tr></thead>
                <tbody>
                @foreach (var question in FilteredQuestions)
                {
                    <tr>
                        <td>@question.Answer</td>
                        <td>@question.Definition</td>
                        <td>@question.Subject?.Name</td>
                        <td>@question.Category?.Name</td>
                        <td>@question.Difficulty</td>
                        <td>@question.IsActive</td>
                        <td>
                            <button class="button small" @onclick="() => ToggleQuestionAsync(question.Id)">@(question.IsActive ? "Dezactiveaza" : "Activeaza")</button>
                            <button class="button small danger" @onclick="() => DeleteQuestionAsync(question.Id)">Sterge</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</main>

@code {
    private List<Category> _categories = [];
    private List<Subject> _subjects = [];
    private List<Question> _questions = [];
    private Question _newQuestion = new() { TimeLimitSeconds = 25 };
    private string? _message;
    private string _filter = string.Empty;
    private string _importText = string.Empty;

    private IEnumerable<Question> FilteredQuestions => string.IsNullOrWhiteSpace(_filter)
        ? _questions
        : _questions.Where(x => x.Answer.Contains(_filter, StringComparison.OrdinalIgnoreCase) || x.Definition.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.Categories.OrderBy(x => x.Name).ToListAsync();
        _subjects = await db.Subjects.OrderBy(x => x.Name).ToListAsync();
        _questions = await db.Questions.Include(x => x.Category).Include(x => x.Subject).OrderBy(x => x.Subject!.Name).ThenBy(x => x.Category!.Name).ThenBy(x => x.Answer).ToListAsync();
        if (_newQuestion.CategoryId == Guid.Empty && _categories.Count > 0)
        {
            _newQuestion.CategoryId = _categories[0].Id;
        }
        if (_newQuestion.SubjectId is null && _subjects.Count > 0)
        {
            _newQuestion.SubjectId = _subjects[0].Id;
        }
    }

    private async Task AddQuestionAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var duplicate = await db.Questions.AnyAsync(x => x.CategoryId == _newQuestion.CategoryId && x.Answer == _newQuestion.Answer);
        if (duplicate)
        {
            _message = "Intrebarea exista deja in categorie.";
            return;
        }
        db.Questions.Add(_newQuestion);
        await db.SaveChangesAsync();
        _newQuestion = new Question { CategoryId = _categories.First().Id, SubjectId = _subjects.FirstOrDefault()?.Id, TimeLimitSeconds = 25 };
        _message = "Intrebare adaugata.";
        await LoadAsync();
    }

    private async Task ToggleQuestionAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var question = await db.Questions.FindAsync(id);
        if (question is not null)
        {
            question.IsActive = !question.IsActive;
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }

    private async Task DeleteQuestionAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var question = await db.Questions.FindAsync(id);
        if (question is not null)
        {
            db.Questions.Remove(question);
            await db.SaveChangesAsync();
        }
        await LoadAsync();
    }

    private async Task ImportAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var imported = QuestionImportParser.Parse(_importText);
        var count = 0;
        foreach (var item in imported)
        {
            var category = await db.Categories.FirstOrDefaultAsync(x => x.Name == item.Category || x.Slug == item.Category.ToLower().Replace(' ', '-'));
            var subjectSlug = item.Subject.ToLowerInvariant().Replace(' ', '-');
            var subject = await db.Subjects.FirstOrDefaultAsync(x => x.Name == item.Subject || x.Slug == subjectSlug);
            if (subject is null)
            {
                subject = new Subject { Name = item.Subject, Slug = subjectSlug };
                db.Subjects.Add(subject);
                await db.SaveChangesAsync();
            }
            if (category is null)
            {
                category = new Category { Name = item.Category, Slug = item.Category.ToLower().Replace(' ', '-') };
                db.Categories.Add(category);
                await db.SaveChangesAsync();
            }
            if (await db.Questions.AnyAsync(x => x.CategoryId == category.Id && x.Answer == item.Answer))
            {
                continue;
            }
            db.Questions.Add(new Question
            {
                Answer = item.Answer,
                Definition = item.Definition,
                SubjectId = subject.Id,
                CategoryId = category.Id,
                Difficulty = Enum.TryParse<Difficulty>(item.Difficulty, true, out var difficulty) ? difficulty : Difficulty.Medium,
                TimeLimitSeconds = item.TimeLimitSeconds ?? 25,
                IsActive = item.IsActive
            });
            count++;
        }
        await db.SaveChangesAsync();
        _message = $"Importate {count} intrebari.";
        await LoadAsync();
    }
}
